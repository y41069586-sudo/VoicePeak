        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening ritual — 3 steps before bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritual de noche — 3 pasos antes de dormir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rituel du soir — 3 étapes avant de dormir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rituale della sera — 3 passaggi prima di dormire."
          }
        }
      }
    },
