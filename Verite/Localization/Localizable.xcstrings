    "scan.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To scan your skin, allow camera access for Glowé in Settings. Your photos still stay on your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deine Haut zu scannen, erlaube Glowé den Kamerazugriff in den Einstellungen. Deine Fotos bleiben trotzdem auf deinem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escanear tu piel, permite el acceso a la cámara para Glowé en Ajustes. Tus fotos seguirán en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour scanner votre peau, autorisez l’accès à l’appareil photo pour Glowé dans Réglages. Vos photos restent sur votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per scansionare la tua pelle, consenti l’accesso alla fotocamera per Glowé in Impostazioni. Le tue foto restano sul tuo dispositivo."
          }
        }
