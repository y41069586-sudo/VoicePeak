    "onboarding.problem.p1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten verschwenden jährlich Hunderte für Produkte, die nie gewirkt haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most people waste hundreds a year on products that never worked for them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría desperdicia cientos al año en productos que nunca les funcionaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des gens gaspillent des centaines par an en produits qui n’ont jamais marché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte spreca centinaia all’anno in prodotti che non hanno mai funzionato."
          }
        }
      }
    },
    "onboarding.problem.p2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Klinisch bewiesen“ heißt oft: ein paar Leute haben sich selbst bewertet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Clinically proven” often means a handful of people rated themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Clínicamente probado” a menudo significa que unas pocas personas se autoevaluaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Cliniquement prouvé » signifie souvent que quelques personnes se sont auto-évaluées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Clinicamente testato” spesso significa che poche persone si sono valutate da sole."
          }
        }
