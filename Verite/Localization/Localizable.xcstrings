    "Evening only, on dry skin. A pea-sized amount for the whole face, avoid the eye area. If it stings, apply moisturizer first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur abends, auf trockener Haut. Erbsengroße Menge fürs ganze Gesicht, Augenpartie aussparen. Bei Brennen erst Creme auftragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening only, on dry skin. A pea-sized amount for the whole face, avoid the eye area. If it stings, apply moisturizer first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo de noche, sobre piel seca. Cantidad tipo guisante para toda la cara, evita los ojos. Si escuece, aplica crema antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir seulement, sur peau sèche. Une noisette pour tout le visage, évite les yeux. Si ça picote, applique la crème d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la sera, su pelle asciutta. Quantità come un pisello per tutto il viso, evita gli occhi. Se brucia, prima la crema."
          }
        }
      }
    },
    "Evening ritual — 3 steps before bed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abendritual — 3 Schritte vor dem Schlafen."
