    },
    "Plumper, less tight skin — usually within days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plumper, less tight skin — usually within days."
          }
        },
        "de": {
          "stringUnit": {
