        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rossore si calma prima se eviti l'acqua calda sul viso."
          }
        }
      }
    },
    "Redness is usually barrier-related — and recoverable.": {
      "extractionState": "manual",
      "localizations": {
