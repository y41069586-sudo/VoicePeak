    "result.noFace.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten deine Haut aus dieser Aufnahme nicht lesen. Suche gleichmäßiges Licht, fülle das Oval aus und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t read your skin from that capture. Find even light, fill the oval, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos leer tu piel en esa captura. Busca luz uniforme, llena el óvalo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu analyser votre peau sur cette capture. Trouvez une lumière uniforme, remplissez l’ovale et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a leggere la tua pelle da questa acquisizione. Trova una luce uniforme, riempi l’ovale e riprova."
          }
        }
      }
    },
