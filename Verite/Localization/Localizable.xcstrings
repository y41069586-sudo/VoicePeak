          }
        }
      }
    },
    "Please try again, or tap Not now to continue.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuch es nochmal, oder tippe auf „Jetzt nicht“, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again, or tap Not now to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtalo de nuevo o toca «Ahora no» para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessaie, ou touche « Pas maintenant » pour continuer."
          }
        },
        "it": {
