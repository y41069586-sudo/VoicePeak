    "legal.impressum.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full text of this document is prepared before the App Store release and reviewed by a lawyer. See the Markdown source in the repository’s Legal folder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vollständige Text dieses Dokuments wird vor der App-Store-Veröffentlichung erstellt und von einer Anwältin oder einem Anwalt geprüft. Siehe die Markdown-Quelle im Legal-Ordner des Repositorys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto completo de este documento se prepara antes del lanzamiento en la App Store y lo revisa un abogado. Consulta el archivo Markdown en la carpeta Legal del repositorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte complet de ce document est rédigé avant la publication sur l’App Store et vérifié par un avocat. Voir la source Markdown dans le dossier Legal du dépôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo completo di questo documento viene redatto prima della pubblicazione sull’App Store e revisionato da un avvocato. Vedi il sorgente Markdown nella cartella Legal del repository."
          }
        }
      },
      "comment": "Placeholder — full localized legal text authored in Milestone 10 (lawyer review required)."
    },
