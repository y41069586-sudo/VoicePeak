    "ingredient.class.irritant.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can irritate sensitive or reddened skin for some people."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann empfindliche oder gerötete Haut bei manchen reizen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede irritar la piel sensible o enrojecida en algunas personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut irriter les peaux sensibles ou rougies chez certaines personnes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può irritare la pelle sensibile o arrossata in alcune persone."
          }
        }
      }
    },
    "ingredient.class.fragrance.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added scent — a common trigger for sensitive skin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugesetzter Duft – ein häufiger Auslöser für empfindliche Haut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aroma añadido: un desencadenante común en pieles sensibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfum ajouté — un déclencheur fréquent pour les peaux sensibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profumo aggiunto — un fattore scatenante comune per la pelle sensibile."
          }
        }
      }
    },
    "ingredient.class.alcohol.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drying alcohol; can strip and sting reactive skin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Austrocknender Alkohol; kann reaktive Haut auslaugen und brennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcohol secante; puede resecar y escocer la piel reactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcool desséchant ; peut dessécher et picoter les peaux réactives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcol essiccante; può seccare e pizzicare la pelle reattiva."
          }
        }
      }
    },
    "ingredient.class.comedogenic.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May clog pores for acne-prone skin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann bei zu Akne neigender Haut die Poren verstopfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede obstruir los poros en pieles con tendencia acneica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut obstruer les pores des peaux à tendance acnéique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può ostruire i pori nella pelle a tendenza acneica."
          }
        }
      }
    },
    "ingredient.class.humectant.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draws in and holds water to hydrate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieht Wasser an und bindet es zur Feuchtigkeitsversorgung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrae y retiene agua para hidratar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attire et retient l’eau pour hydrater."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attira e trattiene l’acqua per idratare."
          }
        }
      }
    },
    "ingredient.class.emollient.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Softens and smooths the skin’s surface."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht die Hautoberfläche weich und geschmeidig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suaviza y alisa la superficie de la piel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adoucit et lisse la surface de la peau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ammorbidisce e leviga la superficie della pelle."
          }
        }
      }
    },
    "ingredient.class.other.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A base, preservative, or supporting ingredient."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Grundlage, ein Konservierungsstoff oder ein Hilfsstoff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una base, conservante o ingrediente de apoyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une base, un conservateur ou un ingrédient de soutien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una base, un conservante o un ingrediente di supporto."
          }
        }
      }
    },
    "ingredient.note.water": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The solvent base most products are built on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lösungsmittelbasis, auf der die meisten Produkte aufbauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base disolvente sobre la que se construyen la mayoría de los productos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base solvante sur laquelle reposent la plupart des produits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La base solvente su cui si costruiscono la maggior parte dei prodotti."
          }
        }
      }
    },
    "ingredient.note.glycerin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle humectant that hydrates almost every skin type."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanftes Feuchthaltemittel, das fast jeden Hauttyp mit Feuchtigkeit versorgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un humectante suave que hidrata casi todo tipo de piel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un humectant doux qui hydrate presque tous les types de peau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un umettante delicato che idrata quasi ogni tipo di pelle."
          }
        }
      }
    },
    "ingredient.note.niacinamide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calms redness, supports the barrier, and evens tone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beruhigt Rötungen, stärkt die Barriere und gleicht den Teint aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calma el enrojecimiento, refuerza la barrera y unifica el tono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaise les rougeurs, renforce la barrière et unifie le teint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenua i rossori, sostiene la barriera e uniforma il tono."
          }
        }
      }
    },
    "ingredient.note.retinol": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerful for texture and aging — but can irritate; ease in slowly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stark bei Hautbild und Alterung – kann aber reizen; langsam einführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Potente para la textura y el envejecimiento, pero puede irritar; introdúcelo despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puissant sur le grain de peau et l’âge — mais peut irriter ; introduisez-le progressivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potente su texture e invecchiamento — ma può irritare; introducilo gradualmente."
          }
        }
      }
    },
    "ingredient.note.vitaminC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Antioxidant that brightens and evens tone; can sting sensitive skin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antioxidans, das aufhellt und den Teint ausgleicht; kann empfindliche Haut brennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antioxidante que ilumina y unifica el tono; puede escocer en piel sensible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antioxydant qui illumine et unifie le teint ; peut picoter les peaux sensibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Antiossidante che illumina e uniforma il tono; può pizzicare la pelle sensibile."
          }
        }
      }
    },
    "ingredient.note.hyaluronic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds water in the skin for a plumped, hydrated look."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bindet Wasser in der Haut für ein aufgepolstertes, feuchtes Aussehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retiene agua en la piel para un aspecto rellenado e hidratado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retient l’eau dans la peau pour un aspect repulpé et hydraté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trattiene l’acqua nella pelle per un aspetto rimpolpato e idratato."
          }
        }
      }
    },
    "ingredient.note.salicylic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An oil-soluble acid that clears pores; can dry out sensitive skin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine öllösliche Säure, die Poren klärt; kann empfindliche Haut austrocknen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ácido soluble en aceite que despeja los poros; puede resecar la piel sensible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acide liposoluble qui désobstrue les pores ; peut dessécher les peaux sensibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acido liposolubile che libera i pori; può seccare la pelle sensibile."
          }
        }
      }
    },
    "ingredient.note.glycolic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An exfoliating acid that smooths texture; raises sun sensitivity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine peelende Säure, die das Hautbild glättet; erhöht die Sonnenempfindlichkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ácido exfoliante que alisa la textura; aumenta la sensibilidad al sol."
          }
