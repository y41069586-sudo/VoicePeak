    "Skin changes week by week, not day by day — one honest scan per week keeps the reading meaningful.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skin changes week by week, not day by day — one honest scan per week keeps the reading meaningful."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut verändert sich Woche für Woche, nicht Tag für Tag — ein ehrlicher Scan pro Woche hält die Messung aussagekräftig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La piel cambia semana a semana, no día a día: un escaneo honesto por semana mantiene la lectura fiable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La peau change de semaine en semaine, pas de jour en jour — un scan honnête par semaine garde la mesure fiable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pelle cambia di settimana in settimana, non di giorno in giorno — una scansione onesta a settimana mantiene la lettura significativa."
          }
        }
      }
    },
