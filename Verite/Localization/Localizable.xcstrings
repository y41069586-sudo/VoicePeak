    "disclaimer.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité tracks change and educates — it’s not medical advice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité verfolgt Veränderungen und informiert – keine medizinische Beratung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité registra cambios e informa; no es asesoramiento médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité suit les changements et informe — ce n’est pas un avis médical."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité monitora i cambiamenti e informa: non è un consiglio medico."
          }
        }
      },
      "comment": "Persistent honesty disclaimer (short). Human translation review recommended."
    },
    "disclaimer.full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité is a tracking and education tool, not medical advice, and not a substitute for a dermatologist. All skin readings are estimates, not clinical measurements. Vérité shows what happened on your skin — it never claims a product works or diagnoses any condition. If you have a skin concern, please consult a qualified professional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité ist ein Tracking- und Bildungswerkzeug, keine medizinische Beratung und kein Ersatz für eine Dermatologin oder einen Dermatologen. Alle Hautwerte sind Schätzungen, keine klinischen Messungen. Vérité zeigt, was auf deiner Haut passiert ist – es behauptet nie, dass ein Produkt wirkt, und stellt keine Diagnose. Bei Hautproblemen wende dich bitte an eine qualifizierte Fachperson."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité es una herramienta de seguimiento y educación, no un consejo médico ni un sustituto de un dermatólogo. Todas las lecturas de la piel son estimaciones, no mediciones clínicas. Vérité muestra lo que ocurrió en tu piel; nunca afirma que un producto funcione ni diagnostica ninguna afección. Si tienes un problema en la piel, consulta a un profesional cualificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité est un outil de suivi et d’information, pas un avis médical ni un substitut à un dermatologue. Toutes les mesures de la peau sont des estimations, et non des mesures cliniques. Vérité montre ce qui s’est passé sur votre peau ; il n’affirme jamais qu’un produit fonctionne et ne pose aucun diagnostic. En cas de problème de peau, consultez un professionnel qualifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité è uno strumento di monitoraggio e informazione, non un consiglio medico né un sostituto del dermatologo. Tutte le letture della pelle sono stime, non misurazioni cliniche. Vérité mostra ciò che è accaduto sulla tua pelle; non afferma mai che un prodotto funzioni e non fornisce diagnosi. In caso di problemi alla pelle, rivolgiti a un professionista qualificato."
          }
        }
      },
      "comment": "Persistent honesty disclaimer (full). Human translation review recommended before release."
    },
