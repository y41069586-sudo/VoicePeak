    "ingredient.note.alcoholDenat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schnell trocknender Alkohol, der reaktive Haut auslaugen und brennen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fast-drying alcohol that can strip and sting reactive skin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alcohol de secado rápido que puede resecar y escocer la piel reactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alcool à séchage rapide qui peut dessécher et picoter les peaux réactives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alcol a rapida evaporazione che può seccare e pizzicare la pelle reattiva."
          }
        }
      }
    },
    "ingredient.note.cica": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Centella (Cica) beruhigt gereizte, gerötete Haut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Centella (cica) soothes and calms irritated, reddened skin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La centella (cica) calma y suaviza la piel irritada y enrojecida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La centella (cica) apaise et calme les peaux irritées et rougies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La centella (cica) lenisce e calma la pelle irritata e arrossata."
          }
        }
      }
    },
    "ingredient.note.fragrance": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Duft ohne Pflegevorteil hinzu; ein häufiger Reizstoff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds scent with no skincare benefit; a frequent irritant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade aroma sin beneficio para la piel; un irritante frecuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un parfum sans bénéfice pour la peau ; un irritant fréquent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge profumo senza benefici per la pelle; un irritante frequente."
          }
        }
      }
    },
    "ingredient.note.glycerin": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanftes Feuchthaltemittel, das fast jeden Hauttyp mit Feuchtigkeit versorgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle humectant that hydrates almost every skin type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un humectante suave que hidrata casi todo tipo de piel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un humectant doux qui hydrate presque tous les types de peau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un umettante delicato che idrata quasi ogni tipo di pelle."
          }
        }
      }
    },
    "ingredient.note.glycolic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine peelende Säure, die das Hautbild glättet; erhöht die Sonnenempfindlichkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An exfoliating acid that smooths texture; raises sun sensitivity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ácido exfoliante que alisa la textura; aumenta la sensibilidad al sol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acide exfoliant qui lisse le grain de peau ; augmente la sensibilité au soleil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acido esfoliante che leviga la texture; aumenta la sensibilità al sole."
          }
        }
      }
    },
    "ingredient.note.hyaluronic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bindet Wasser in der Haut für ein aufgepolstertes, feuchtes Aussehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds water in the skin for a plumped, hydrated look."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retiene agua en la piel para un aspecto rellenado e hidratado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retient l’eau dans la peau pour un aspect repulpé et hydraté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trattiene l’acqua nella pelle per un aspetto rimpolpato e idratato."
          }
        }
      }
    },
    "ingredient.note.niacinamide": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beruhigt Rötungen, stärkt die Barriere und gleicht den Teint aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calms redness, supports the barrier, and evens tone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calma el enrojecimiento, refuerza la barrera y unifica el tono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaise les rougeurs, renforce la barrière et unifie le teint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenua i rossori, sostiene la barriera e uniforma il tono."
          }
        }
      }
    },
    "ingredient.note.retinol": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stark bei Hautbild und Alterung – kann aber reizen; langsam einführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerful for texture and aging — but can irritate; ease in slowly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Potente para la textura y el envejecimiento, pero puede irritar; introdúcelo despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puissant sur le grain de peau et l’âge — mais peut irriter ; introduisez-le progressivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potente su texture e invecchiamento — ma può irritare; introducilo gradualmente."
          }
        }
      }
    },
    "ingredient.note.salicylic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine öllösliche Säure, die Poren klärt; kann empfindliche Haut austrocknen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An oil-soluble acid that clears pores; can dry out sensitive skin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ácido soluble en aceite que despeja los poros; puede resecar la piel sensible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acide liposoluble qui désobstrue les pores ; peut dessécher les peaux sensibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acido liposolubile che libera i pori; può seccare la pelle sensibile."
          }
        }
      }
    },
    "ingredient.note.vitaminC": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antioxidans, das aufhellt und den Teint ausgleicht; kann empfindliche Haut brennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Antioxidant that brightens and evens tone; can sting sensitive skin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antioxidante que ilumina y unifica el tono; puede escocer en piel sensible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antioxydant qui illumine et unifie le teint ; peut picoter les peaux sensibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Antiossidante che illumina e uniforma il tono; può pizzicare la pelle sensibile."
          }
        }
      }
    },
    "ingredient.note.water": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
