    "Some things shift in two weeks. Some take longer. We'll be honest about which.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some things shift in two weeks. Some take longer. We'll be honest about which."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manches ändert sich in zwei Wochen. Manches dauert länger. Wir sagen ehrlich, was."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas cosas cambian en dos semanas. Otras tardan más. Seremos honestos sobre cuáles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines choses bougent en deux semaines. D’autres prennent plus de temps. On sera honnêtes là-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune cose cambiano in due settimane. Altre richiedono più tempo. Saremo onesti su quali."
          }
        }
      }
