        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short sleep + no SPF cost the most — and win back fastest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco sueño + sin SPF cuestan más — y se recuperan más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de sommeil + pas de SPF coûtent le plus — et se rattrapent le plus vite."
          }
