    "match.needScan.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glowé matches products to your real skin readings. Take a baseline scan to unlock this."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glowé gleicht Produkte mit deinen echten Hautwerten ab. Mach einen Ausgangsscan, um das freizuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glowé compara los productos con tus lecturas reales de la piel. Haz un escaneo inicial para desbloquearlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glowé met en correspondance les produits avec vos vraies mesures de peau. Faites un scan de référence pour le débloquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Glowé confronta i prodotti con le tue letture reali della pelle. Fai una scansione iniziale per sbloccarlo."
          }
        }
      }
    },
