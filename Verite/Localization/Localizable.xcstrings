    "Redness calms fastest when you skip hot water on your face.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rötung beruhigt sich am schnellsten, wenn du heißes Wasser im Gesicht weglässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redness calms fastest when you skip hot water on your face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enrojecimiento se calma más rápido si evitas el agua caliente en la cara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rougeurs s'apaisent plus vite si tu évites l'eau chaude sur le visage."
          }
