    "Evens the tone variance behind your evenness score (%lld).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleicht die Tonunterschiede hinter deinem Ebenmäßigkeit-Score (%lld) aus."
          }
        },
