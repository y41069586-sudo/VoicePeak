          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piel más tersa y menos tirante, normalmente en días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une peau plus rebondie et moins tiraillée — souvent en quelques jours."
          }
        },
