    "onboarding.promise.s1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A private, on-device read of your skin. Photos never leave your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine private Analyse deiner Haut direkt auf dem Gerät. Fotos verlassen nie dein Handy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un análisis privado de tu piel en el dispositivo. Las fotos nunca salen de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse privée de votre peau sur l’appareil. Les photos ne quittent jamais votre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’analisi privata della tua pelle sul dispositivo. Le foto non lasciano mai il telefono."
          }
        }
      }
    },
    "onboarding.promise.s2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get an honest match"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine ehrliche Einschätzung"
          }
        },
        "es": {
          "stringUnit": {
