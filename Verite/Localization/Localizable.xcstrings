    "“In 14 days” is a careful projection if you follow your plan — not a promise.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„In 14 Tagen“ ist eine vorsichtige Prognose, wenn du deinen Plan befolgst — kein Versprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“In 14 days” is a careful projection if you follow your plan — not a promise."
          }
        },
        "es": {
