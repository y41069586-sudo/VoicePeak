    "Pore size is largely fixed; you manage the look, not shrink them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pore size is largely fixed; you manage the look, not shrink them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Porengröße ist weitgehend fix; du steuerst das Aussehen, verkleinerst sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño del poro es casi fijo; gestionas su aspecto, no los reduces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille des pores est quasi fixe ; tu gères l’apparence, tu ne les réduis pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dimensione dei pori è quasi fissa; ne gestisci l’aspetto, non li rimpicciolisci."
          }
        }
      }
    },
    "Pore visibility is dragging the whole picture down, mostly through the T-zone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichtbare Poren ziehen das ganze Bild runter, vor allem in der T-Zone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pore visibility is dragging the whole picture down, mostly through the T-zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La visibilidad de los poros baja todo el conjunto, sobre todo en la zona T."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La visibilité des pores tire tout vers le bas, surtout dans la zone T."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La visibilità dei pori abbassa tutto il quadro, soprattutto nella zona T."
          }
        }
      }
