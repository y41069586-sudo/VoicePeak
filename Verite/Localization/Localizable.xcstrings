    "Skin moves week by week — your three weekly readings are in. The next one unlocks soon.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skin moves week by week — your three weekly readings are in. The next one unlocks soon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut verändert sich Woche für Woche — deine drei Wochen-Messungen sind drin. Die nächste schaltet bald frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La piel cambia semana a semana: tus tres lecturas semanales ya están. La próxima se desbloquea pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La peau évolue de semaine en semaine — tes trois mesures hebdo sont faites. La prochaine se débloque bientôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pelle cambia di settimana in settimana — le tue tre letture settimanali sono fatte. La prossima si sblocca presto."
          }
        }
      }
    },
    "Skin moves week by week — your two weekly readings are in. Need one more now? Grab an extra scan, or the next one unlocks free soon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut verändert sich Woche für Woche — deine zwei wöchentlichen Analysen sind durch. Jetzt noch eine? Hol dir einen Extra-Scan, oder die nächste schaltet bald kostenlos frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skin moves week by week — your two weekly readings are in. Need one more now? Grab an extra scan, or the next one unlocks free soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La piel cambia semana a semana — tus dos análisis semanales están hechos. ¿Necesitas uno más ahora? Consigue un escaneo extra, o el próximo se desbloquea gratis pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La peau évolue semaine après semaine — tes deux analyses hebdomadaires sont faites. Besoin d'un scan de plus ? Prends-en un en plus, ou le prochain se débloque bientôt gratuitement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pelle cambia settimana dopo settimana — le tue due analisi settimanali sono fatte. Ne serve un'altra ora? Prendi una scansione extra, o la prossima si sblocca presto gratis."
          }
        }
      }
    },
