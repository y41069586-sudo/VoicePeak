    "14 days, morning and evening — every step aimed at your three weakest scores.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "14 Tage, morgens und abends — jeder Schritt zielt auf deine drei schwächsten Scores."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14 days, morning and evening — every step aimed at your three weakest scores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "14 días, mañana y noche — cada paso apunta a tus tres puntuaciones más bajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 jours, matin et soir — chaque étape vise tes trois scores les plus faibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "14 giorni, mattina e sera — ogni passaggio mira ai tuoi tre punteggi più bassi."
          }
        }
      }
    },
    "14 days, morning and evening.\nSign it — for yourself, not for us.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "14 Tage, morgens und abends.\nUnterschreib — für dich, nicht für uns."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14 days, morning and evening.\nSign it — for yourself, not for us."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "14 días, mañana y noche.\nFírmalo — por ti, no por nosotros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 jours, matin et soir.\nSigne — pour toi, pas pour nous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "14 giorni, mattina e sera.\nFirmalo — per te, non per noi."
          }
        }
      }
    },
