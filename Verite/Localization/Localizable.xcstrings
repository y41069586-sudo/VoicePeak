    "test.setup.hygiene.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere sonst nichts während des Tests: gleicher Reiniger, alles gleich. Nur das getestete Produkt unterscheidet sich zwischen den Seiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change nothing else for the duration: same cleanser, same everything. Only the tested product differs between sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambies nada más durante la prueba: el mismo limpiador, todo igual. Solo el producto probado difiere entre lados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne changez rien d’autre pendant le test : même nettoyant, tout pareil. Seul le produit testé diffère entre les côtés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambiare nient’altro per tutta la durata: stesso detergente, tutto uguale. Solo il prodotto testato cambia tra i lati."
          }
        }
      }
    },
