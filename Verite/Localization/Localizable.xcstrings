    "Evening, on clean dry skin before moisturizer. Never the same night as your retinoid.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abends auf sauberer, trockener Haut vor der Creme. Nie in derselben Nacht wie dein Retinoid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening, on clean dry skin before moisturizer. Never the same night as your retinoid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De noche, sobre piel limpia y seca antes de la crema. Nunca la misma noche que tu retinoide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir, sur peau propre et sèche avant la crème. Jamais le même soir que ton rétinoïde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sera, su pelle pulita e asciutta prima della crema. Mai la stessa notte del retinoide."
          }
        }
      }
    },
    "Evening, on dry skin before moisturizer. Don't layer with your retinoid or BHA the same night.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abends auf trockener Haut vor der Creme. Nicht in derselben Nacht mit Retinoid oder BHA kombinieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening, on dry skin before moisturizer. Don't layer with your retinoid or BHA the same night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De noche, sobre piel seca antes de la crema. No lo mezcles con tu retinoide o BHA la misma noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir, sur peau sèche avant la crème. Ne le combine pas avec ton rétinoïde ou BHA le même soir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sera, su pelle asciutta prima della crema. Non abbinarlo a retinoide o BHA la stessa notte."
          }
        }
      }
    },
