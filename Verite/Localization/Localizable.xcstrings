    "1–2× a week. Spread an even layer, leave 10 minutes, then rinse off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1–2× pro Woche. Gleichmäßig auftragen, 10 Minuten einwirken, abspülen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1–2× a week. Spread an even layer, leave 10 minutes, then rinse off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1–2× por semana. Aplica una capa uniforme, deja 10 minutos y aclara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1–2× par semaine. Couche uniforme, laisse 10 minutes, puis rince."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1–2 volte a settimana. Strato uniforme, lascia 10 minuti, poi risciacqua."
