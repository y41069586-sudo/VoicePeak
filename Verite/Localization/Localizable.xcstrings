    "onboarding.problem.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The beauty industry runs on hope."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beauty-Branche lebt von Hoffnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La industria de la belleza vive de la esperanza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’industrie de la beauté vit d’espoir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’industria della bellezza vive di speranza."
          }
        }
      }
    },
    "onboarding.problem.p1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most people waste hundreds a year on products that never worked for them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten verschwenden jährlich Hunderte für Produkte, die nie gewirkt haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría desperdicia cientos al año en productos que nunca les funcionaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des gens gaspillent des centaines par an en produits qui n’ont jamais marché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte spreca centinaia all’anno in prodotti che non hanno mai funzionato."
          }
        }
      }
    },
    "onboarding.problem.p2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Clinically proven” often means a handful of people rated themselves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Klinisch bewiesen“ heißt oft: ein paar Leute haben sich selbst bewertet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Clínicamente probado” a menudo significa que unas pocas personas se autoevaluaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Cliniquement prouvé » signifie souvent que quelques personnes se sont auto-évaluées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Clinicamente testato” spesso significa che poche persone si sono valutate da sole."
          }
        }
      }
    },
    "onboarding.problem.p3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve never actually seen whether a product changed your skin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast nie wirklich gesehen, ob ein Produkt deine Haut verändert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca has visto de verdad si un producto cambió tu piel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez jamais vraiment vu si un produit a changé votre peau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai mai visto davvero se un prodotto ha cambiato la tua pelle."
          }
        }
      }
    },
    "onboarding.problem.turn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glowé is built to prove it — or drop it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glowé ist dafür gemacht, es zu beweisen – oder es fallen zu lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glowé está hecho para demostrarlo — o descartarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glowé est conçu pour le prouver — ou l’abandonner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Glowé è fatto per dimostrarlo — o scartarlo."
          }
        }
      }
    },
    "onboarding.promise.s1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
