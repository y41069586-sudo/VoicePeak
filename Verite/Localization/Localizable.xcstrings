    "scan.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze your skin, privately"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiere deine Haut – privat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza tu piel, en privado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez votre peau, en privé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza la tua pelle, in privato"
          }
        }
      }
    },
    "scan.permission.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité uses the camera to analyze your skin and scan product barcodes. Photos are processed on your device and never uploaded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité verwendet die Kamera, um deine Haut zu analysieren und Produkt-Barcodes zu scannen. Fotos werden auf deinem Gerät verarbeitet und niemals hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité usa la cámara para analizar tu piel y escanear códigos de barras. Las fotos se procesan en tu dispositivo y nunca se suben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité utilise l’appareil photo pour analyser votre peau et scanner les codes-barres. Les photos sont traitées sur votre appareil et ne sont jamais téléchargées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérité usa la fotocamera per analizzare la tua pelle e scansionare i codici a barre. Le foto vengono elaborate sul dispositivo e non vengono mai caricate."
          }
        }
      }
    },
    "scan.permission.enable": {
      "extractionState": "manual",
      "localizations": {
