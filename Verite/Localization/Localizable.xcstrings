        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lado tratado no superó al control. Ese es dinero que no necesitas gastar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le côté traité n’a pas dépassé le témoin. C’est de l’argent que vous n’avez pas à dépenser."
