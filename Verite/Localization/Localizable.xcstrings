          }
        }
      }
    },
    "onboarding.promise.s2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Risks first. We flag what might irritate you before what might help."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Risiken zuerst. Wir markieren, was reizen könnte, bevor wir zeigen, was helfen könnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero los riesgos. Señalamos lo que podría irritarte antes de lo que podría ayudar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les risques d’abord. Nous signalons ce qui peut irriter avant ce qui peut aider."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima i rischi. Segnaliamo ciò che potrebbe irritare prima di ciò che potrebbe aiutare."
          }
        }
      }
    },
    "onboarding.promise.s3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prove it on your skin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweise es auf deiner Haut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demuéstralo en tu piel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prouvez-le sur votre peau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimostralo sulla tua pelle"
          }
        }
      }
    },
    "onboarding.promise.s3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test one product on half your face. Keep only what actually works."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste ein Produkt auf einer Gesichtshälfte. Behalte nur, was wirklich wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba un producto en media cara. Quédate solo con lo que de verdad funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Testez un produit sur la moitié du visage. Ne gardez que ce qui marche vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un prodotto su metà viso. Tieni solo ciò che funziona davvero."
          }
        }
      }
    },
