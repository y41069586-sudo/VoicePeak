<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SKINMAXX</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.3</string>
	<key>CFBundleVersion</key>
	<string>12</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Required for App Store upload when using a manual Info.plist: points at
	     the asset-catalog icon set (AppIcon). Without it the upload is rejected. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>

	<!-- App uses only standard/exempt encryption (HTTPS). Declaring this skips the
	     manual export-compliance question on every TestFlight build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Custom URL scheme for Skin Duel invite/result deep links
	     (verite://duel?d=…). Opened via .onOpenURL in RootView. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.verite.com</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>verite</string>
			</array>
		</dict>
	</array>

	<!-- App Store category. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.lifestyle</string>

	<!-- Supported UI languages (mirrors the String Catalog). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>it</string>
	</array>

	<!-- Honest, specific camera reason. Localized via InfoPlist.xcstrings. -->
	<key>NSCameraUsageDescription</key>
	<string>SKINMAXX uses the camera to analyze your skin and scan product barcodes. Photos are processed on your device and never uploaded.</string>

	<!-- Warm, light GlamUp look — committed app-wide. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>

	<!-- A compiled launch storyboard is the decisive "supports every screen
	     size" signal. The previous UILaunchScreen dict (asset-color reference)
	     is the known-flaky path with manual plists — when iOS fails to resolve
	     it at snapshot time, the app is letterboxed into the small legacy
	     canvas (the shrunken 3:4-ish iPad compatibility window). -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- Opt into the modern scene lifecycle. Without this, a manually-managed
	     Info.plist makes iOS treat the app as legacy and render it in a small
	     letterboxed compatibility window on iPad instead of full native size.
	     SwiftUI's App lifecycle supplies the scene; single-window app. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- arm64 is the only architecture on every supported device; the old
	     armv7 (32-bit) value is legacy and also flags the app as pre-modern. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- Display font: Playfair Display (SIL OFL), two variable TTFs (upright +
	     italic) bundled in Resources/Fonts/. VType selects weight via the wght
	     axis and the italic face via .italic; family name is "Playfair Display". -->
	<key>UIAppFonts</key>
	<array>
		<string>PlayfairDisplay.ttf</string>
		<string>PlayfairDisplay-Italic.ttf</string>
	</array>
</dict>
</plist>
