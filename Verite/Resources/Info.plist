<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Vérité</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.3</string>
	<key>CFBundleVersion</key>
	<string>4</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Required for App Store upload when using a manual Info.plist: points at
	     the asset-catalog icon set (AppIcon). Without it the upload is rejected. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>

	<!-- App uses only standard/exempt encryption (HTTPS). Declaring this skips the
	     manual export-compliance question on every TestFlight build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- App Store category. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.lifestyle</string>

	<!-- Supported UI languages (mirrors the String Catalog). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>it</string>
	</array>

	<!-- Honest, specific camera reason. Localized via InfoPlist.xcstrings. -->
	<key>NSCameraUsageDescription</key>
	<string>Vérité uses the camera to analyze your skin and scan product barcodes. Photos are processed on your device and never uploaded.</string>

	<!-- Light-first white-and-blue committed look. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- iPhone-only, portrait-only app: explicitly opt out of iPad Split View /
	     Slide Over multitasking. Without this, App Store Connect validation
	     (errors 90474/90475) requires a multitasking-ready launch screen and all
	     4 orientations even though TARGETED_DEVICE_FAMILY is iPhone-only. -->
	<key>UIRequiresFullScreen</key>
	<true/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>

	<!-- Display font: Playfair Display (SIL OFL), two variable TTFs (upright +
	     italic) bundled in Resources/Fonts/. VType selects weight via the wght
	     axis and the italic face via .italic; family name is "Playfair Display". -->
	<key>UIAppFonts</key>
	<array>
		<string>PlayfairDisplay.ttf</string>
		<string>PlayfairDisplay-Italic.ttf</string>
	</array>
</dict>
</plist>
