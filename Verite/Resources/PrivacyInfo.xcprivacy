<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Glowé privacy manifest. No third-party tracking SDK and no analytics SDK ship in
  the app (NSPrivacyTracking = false). The scan photo IS sent (encrypted in transit)
  to our skin-analysis provider to compute the user's scores and is not retained
  after the result — it is used only to service the user's own request. It is not
  used for tracking and is never sold. Keep the App Store Connect privacy label in
  sync with this if a photo is ever stored or an analytics sink is wired.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- @AppStorage / UserDefaults for app settings (language override, etc.). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
