// Copy this file to Secrets.xcconfig (already git-ignored — never commit that
// one) and fill in your real values for local builds.
//
// Only API keys go here — NOT base URLs. xcconfig treats "//" as a comment, so
// a URL like https://... would be mangled; base URLs are hardcoded in the Swift
// config structs (DermIQConfig / ClaudeConfig) instead.
//
// CI (Codemagic) writes Secrets.xcconfig itself before every build — see the
// "Write Secrets.xcconfig" step in codemagic.yaml — from DERMIQ_API_KEY /
// ANTHROPIC_API_KEY environment variables/secret groups, if configured there.

DERMIQ_API_KEY =
ANTHROPIC_API_KEY =
